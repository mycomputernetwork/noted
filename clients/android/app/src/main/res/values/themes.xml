<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Noted" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="Theme.Noted.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_boil</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Noted</item>
    </style>
</resources>
