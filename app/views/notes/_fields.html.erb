<%#
  The editor's fields, and nothing about the surface they sit on (PRD §8.4).

  Three surfaces render this partial: the modal that opens from a card
  (§8.2), the composer that expands in place at the top of the board, and —
  in milestone 4 — the full pane. The wrapper around it supplies the autosave
  controller's values and its actions; everything here is the same in all
  three.

  Locals: note, folders, and optionally close_action / close_label.

  The close control is optional because the full pane has nothing to close:
  leaving it is navigating away, which autosave already flushes on. The
  fields themselves are identical on all three surfaces — that is the part
  that must not vary.
%>
<%= form_with url: notes_path, method: :post, class: "editor",
              data: { autosave_target: "form", turbo: false } do %>
  <%# Pinning is a property of the note, not a step in writing one, so it
      sits in the corner rather than in the row of controls you pass through
      on the way out. Top right is also where the card carried it until the
      Pinned section made that redundant. %>
  <label class="editor__pin" title="Pin to the top of the board">
    <input type="hidden" name="note[pinned]" value="0">
    <input type="checkbox" name="note[pinned]" value="1" <%= "checked" if note.pinned? %>>
    <span class="visually-hidden">Pin</span>
    <%= render "notes/pin_icon" %>
  </label>

  <input type="text"
         name="note[title]"
         value="<%= note.title %>"
         class="editor__title"
         placeholder="Title"
         autocomplete="off"
         aria-label="Title">

  <textarea name="note[body]"
            class="editor__body"
            placeholder="Take a note…"
            aria-label="Note"
            rows="<%= note.persisted? ? 4 : 3 %>"
            data-controller="autogrow"
            data-action="input->autogrow#resize"
            <%= "autofocus" unless note.persisted? %>><%= note.body %></textarea>

  <footer class="editor__footer">
    <label class="editor__folder">
      <span class="visually-hidden">Folder</span>
      <select name="note[folder_id]" aria-label="Folder">
        <option value="">No folder</option>
        <%= options_from_collection_for_select(folders, :id, :name, note.folder_id) %>
      </select>
    </label>

    <span class="editor__spacer"></span>

    <%# Saving is implicit, so the only feedback that it happened is here. It
        starts empty: an editor that says "Saved" before anything was typed is
        claiming something that did not happen. %>
    <span class="editor__status" role="status" aria-live="polite"
          data-autosave-target="status"></span>

    <% if local_assigns[:close_action] %>
      <button type="button" class="editor__close" data-action="<%= close_action %>">
        <%= close_label %>
      </button>
    <% end %>
  </footer>
<% end %>
