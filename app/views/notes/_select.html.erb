<label class="card__select" title="Select note" draggable="false">
  <input type="checkbox"
         aria-label="Select note"
         data-action="click->selection#toggle">
  <span class="card__select-control" aria-hidden="true">
    <%= render "icons/material_symbol", name: :check, class_name: "card__select-check" %>
  </span>
</label>
