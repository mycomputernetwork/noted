<%#
  The full-pane note — what a sidebar row opens.

  There is no Done button: leaving is navigating away, and autosave flushes on
  `turbo:before-visit` and on unload.
%>
<% content_for :title, "#{@note.tree_label} — noted" %>

<main class="pane">
  <%= link_to pane_back_path(@note), class: "pane__back" do %>
    ← <%= @note.folder&.name || "Notes" %>
  <% end %>

  <div class="pane__sheet"
       data-controller="autosave"
       data-autosave-url-value="<%= api_v1_note_path(@note) %>">
    <%= render "notes/fields", note: @note, folders: @folders %>
  </div>
</main>
