<% content_for :title, "notbuk" %>

<% content_for :header_controls do %>
  <nav class="sort" aria-label="Sort notes">
    <span class="sort__label">Sort</span>
    <%= link_to "Edited", sort_option_path("edited"),
          class: "sort__option", "aria-current": (@sort == "edited").to_s %>
    <%= link_to "Created", sort_option_path("created"),
          class: "sort__option", "aria-current": (@sort == "created").to_s %>
    <%= link_to sort_direction_path, class: "sort__direction",
          title: sort_direction_label, "aria-label": sort_direction_label do %>
      <%= @direction == "asc" ? "↑" : "↓" %>
    <% end %>
  </nav>
<% end %>

<main class="board">
  <%#
    Capture first, board second (PRD §17). It is a link rather than a real
    input because the field it looks like is the editor's body field — one
    text field for a note, not one that hands off to another mid-thought.

    Its own frame, so clicking it expands the composer in place rather than
    opening a dialog (PRD §8.2): the note is written where it is about to
    live, and the board it will drop into stays in view.
  %>
  <%= turbo_frame_tag "composer", class: "composer-slot" do %>
    <%= link_to new_note_path, class: "composer" do %>
      <span class="composer__field">Take a note…</span>
    <% end %>
  <% end %>

  <% if @pinned.empty? && @others.empty? %>
    <div class="empty">
      <p class="empty__title">No notes yet</p>
      <p class="empty__hint">Start one above.</p>
    </div>
  <% else %>
    <% if @pinned.any? %>
      <section class="board__section" aria-labelledby="pinned-heading">
        <h2 class="board__heading" id="pinned-heading">Pinned</h2>
        <%= render "notes/board", notes: @pinned %>
      </section>
    <% end %>

    <% if @others.any? %>
      <section class="board__section" aria-labelledby="others-heading">
        <h2 class="board__heading" id="others-heading">
          <%= @pinned.any? ? "Others" : "Notes" %>
        </h2>
        <%= render "notes/board", notes: @others %>
      </section>
    <% end %>
  <% end %>
</main>

<%# The modal editor loads into here (PRD §8.2). Empty until a card is
    clicked, so the board costs nothing to render. The composer has its own
    frame above, because it expands in place rather than over the board. %>
<%= turbo_frame_tag "editor" %>
