<%#
  The composer, expanded in place rather than in a dialog: a new note has no
  context behind it worth preserving, and it should appear where it will live.

  Nothing is written until the first keystroke, so this renders over an unsaved
  Note.
%>
<%= turbo_frame_tag "composer" do %>
  <section class="composer composer--open"
           data-controller="composer autosave"
           data-autosave-url-value=""
           data-new-url="<%= new_note_path(folder_id: @note.folder_id) %>"
           data-action="autosave:saved->composer#remember
                        autosave:discarded->composer#forget
                        composer:done->autosave#finalize
                        autosave:finalized->composer#teardown">
    <%= render "notes/fields", note: @note, folders: @folders,
          close_action: "composer#close", close_label: "Done" %>
  </section>
<% end %>
