<%#
  A folder row: two targets in one row (PRD §7.6). The triangle expands, the
  name filters the board. Rename is a third, deliberately quiet — it appears
  on hover and swaps this row for a form in place, which is what the frame is
  for.

  It is also a drop target for a card dragged off any board (§11).

  Locals: folder, notes.
%>
<%= turbo_frame_tag dom_id(folder, :row) do %>
  <div class="row row--folder"
       data-folder-id="<%= folder.id %>"
       data-action="dragover->filing#over dragleave->filing#leave drop->filing#drop"
       <%= "aria-current=true" if @folder&.id == folder.id %>>
    <button type="button"
            class="row__twist"
            data-tree-target="twist"
            data-folder-id="<%= folder.id %>"
            data-action="tree#toggle"
            aria-controls="<%= dom_id(folder, :notes) %>"
            aria-expanded="true">
      <span class="visually-hidden">Expand <%= folder.name %></span>
      <span aria-hidden="true">▾</span>
    </button>

    <%= link_to folder.name, folder_path(folder), class: "row__label" %>

    <%= link_to edit_folder_path(folder), class: "row__edit",
          title: "Rename #{folder.name}" do %>
      <span class="visually-hidden">Rename <%= folder.name %></span>
      <span aria-hidden="true">✎</span>
    <% end %>

    <span class="row__count"><%= notes.size %></span>
  </div>
<% end %>
