<% content_for :title, "Sign in — noted" %>

<div class="signin">
  <%= image_tag "noted_white-boil.gif", alt: "noted", class: "signin__brand" %>

  <% if AuthService.stubbed? %>
    <p class="signin__hint">Development sign-in.</p>
    <ul class="signin__users">
      <% @stub_users.each do |user| %>
        <li><%= button_to user[:name], dev_sign_in_path, params: { email: user[:email] }, class: "signin__button" %></li>
      <% end %>
    </ul>
  <% else %>
    <%= button_to "Sign in", "/auth/oidc", class: "signin__button", data: { turbo: false } %>
  <% end %>

  <div class="signin__download">
    <%= link_to @android_release&.download_url || AndroidRelease::LATEST_DOWNLOAD_URL, class: "signin__download-link" do %>
      <%= image_tag "noted_android_icon_white_on_amber.png", alt: "", class: "signin__download-icon" %>
      <span>Download Android APK</span>
    <% end %>
    <% if @android_release %>
      <p class="signin__download-meta"><span title="Released <%= @android_release.published_on %>">v<%= @android_release.version %></span></p>
    <% end %>
  </div>
</div>
