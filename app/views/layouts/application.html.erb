<!DOCTYPE html>
<html lang="en">
  <%= render "layouts/head" %>

  <body>
    <%# `filing` sits on the shell rather than on either end of the drag: the
        card is in the main pane and the folder row it is dropped onto is in
        the sidebar, and one controller has to see both. %>
    <div class="shell shell--railed" data-controller="filing sync"
         data-action="dragstart->filing#start dragend->filing#end
                      modal:expand->sync#hold
                      autosave:finalized->sync#flush">
      <header class="header" data-controller="logo">
        <%= image_tag "noted_white-boil.gif", alt: "noted", class: "header__brand", data: { "logo-target": "animated", "static-src": asset_path("noted_white.png") } %>
        <span class="header__spacer"></span>
        <%= yield :header_controls %>
        <%= render "layouts/account" %>
      </header>

      <%= render "layouts/rail" %>

      <%= yield %>

      <% if flash[:alert] %>
        <p class="flash" role="status"><%= flash[:alert] %></p>
      <% end %>
    </div>
  </body>
</html>
