<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "notbuk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#131315">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Closing the editor revisits the board's own URL (PRD §8.2). Morphing
        makes that a patch rather than a rebuild: scroll holds, the masonry
        layout survives, and only the cards that actually changed move. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# The shell is two columns from milestone 4 on. `filing` sits here
        rather than on either end of the drag: the card is in the main pane
        and the folder row it is dropped onto is in the sidebar, and one
        controller has to see both (PRD §11). %>
    <div class="shell shell--railed" data-controller="filing"
         data-action="dragstart->filing#start dragend->filing#end">
      <header class="header">
        <span class="header__brand">not<em>buk</em></span>
        <span class="header__spacer"></span>
        <%= yield :header_controls %>
      </header>

      <%# Navigation moved out of the header and into the tree, which is the
          primary navigation from here on (PRD §6). %>
      <%= render "layouts/rail" %>

      <%= yield %>

      <% if flash[:alert] %>
        <p class="flash" role="status"><%= flash[:alert] %></p>
      <% end %>
    </div>
  </body>
</html>
