<details class="account">
  <summary class="account__name"><%= current_user.name || current_user.email %></summary>
  <div class="account__menu">
    <p class="account__email"><%= current_user.email %></p>
    <%= button_to "Sign out", logout_path, method: :delete, class: "account__signout" %>
  </div>
</details>
