<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "noted" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#131315">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Closing the editor revisits the board's own URL (PRD §8.2). Morphing
        makes that a patch rather than a rebuild: scroll holds, the masonry
        layout survives, and only the cards that actually changed move. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="plain">
    <main class="plain__main">
      <% if flash[:alert] %>
        <p class="flash" role="status"><%= flash[:alert] %></p>
      <% end %>
      <% if flash[:notice] %>
        <p class="flash" role="status"><%= flash[:notice] %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
