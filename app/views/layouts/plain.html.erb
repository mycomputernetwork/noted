<!DOCTYPE html>
<html lang="en">
  <%= render "layouts/head" %>

  <body class="plain">
    <main class="plain__main">
      <% if flash[:alert] %>
        <p class="flash" role="status"><%= flash[:alert] %></p>
      <% end %>
      <% if flash[:notice] %>
        <p class="flash" role="status"><%= flash[:notice] %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
